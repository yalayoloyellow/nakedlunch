#!/bin/zsh
# nakedlunch.app — ЯРЛЫК, КОТОРЫЙ ВСЕГДА ЗАПУСКАЕТ ЖИВОЙ КОД.
#
# ЗАЧЕМ ОН ЛЕЖИТ В РЕПОЗИТОРИИ, А НЕ НА СТОЛЕ (2026-08-18). Прежний ярлык жил
# на рабочем столе и держал путь `/Users/yala/nakedlunch` ЗАШИТЫМ внутри. Из
# этого следовали две беды: он не ехал на GitHub вместе с программой, и любое
# перемещение папки его ломало. Владелец сформулировал требование прямо: «хочу,
# чтобы значок вызывал ровно ту версию, которая у нас будет и которую мы потом
# зальём на GitHub, и чтобы так было всегда».
#
# Теперь корень вычисляется ИЗ СОБСТВЕННОГО МЕСТА: файл лежит в
# <корень>/nakedlunch.app/Contents/MacOS/, значит четыре уровня вверх — корень.
# Перенесёшь папку, переименуешь, склонируешь на другую машину — ярлык поедет
# вместе с ней и продолжит работать. На столе достаточно ссылки сюда.
#
# ПОЧЕМУ НЕ exec (правка 2026-08-03, сохранена). С exec питон наследовал PID
# оболочки бандла, и LaunchServices считал приложение запущенным всё время
# работы. Повторный клик по ярлыку НЕ доходил сюда вовсе: `open` видел
# «приложение уже запущено» и слал ему активацию. Замерено: PID до клика и
# после — те же. Владелец видел старое окно и делал верный вывод: «через ярлык
# новый nakedlunch не открывается с апдейтами».
#
# Процесс отвязан (& + disown), оболочка сразу выходит: бандл не держит личность
# приложения, и КАЖДЫЙ клик реально запускает launch.py. Что делать дальше —
# поднять окно работающего экземпляра или перезапустить его с обновлениями —
# решает сам launch.py по data/instance.json.
#
# Двух иконок в доке от этого не появляется: оболочка живёт доли секунды, а
# иконку и имя ставит brand_app() в launch.py.

set -e

fail() {
  /usr/bin/osascript -e 'on run argv
    display alert "nakedlunch не запустился" message (item 1 of argv) as critical
  end run' "$1" >/dev/null 2>&1
  exit 1
}

# .../<корень>/nakedlunch.app/Contents/MacOS/nakedlunch → четыре уровня вверх
APP="${0:A:h:h:h:h}"
PY="$APP/.venv/bin/python"
LOG="$HOME/Library/Logs/nakedlunch.log"

[ -f "$APP/launch.py" ] || fail "Рядом с ярлыком нет launch.py.

Ожидалось: $APP/launch.py
Ярлык обязан лежать В КОРНЕ программы, как nakedlunch.app/. Если ты вынес его
отдельно — верни обратно, а на столе оставь ссылку (⌘⌥-перетаскивание)."

[ -x "$PY" ] || fail "Нет рабочего окружения: $PY

Собери его:
  cd $APP
  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"

/bin/mkdir -p "${LOG:h}"
"$PY" "$APP/launch.py" >>"$LOG" 2>&1 &
disown
exit 0
