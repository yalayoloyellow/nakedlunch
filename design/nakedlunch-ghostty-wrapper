#!/bin/zsh
# Wrapper to launch nakedlunch in beautiful Ghostty CRT visual
# Design saved in /Users/yala/nakedlunch/design/ (config, shaders, this script, restore instructions)
# Now using freshly built binary from latest source (v1.2)
# Built locally with PyInstaller (rich and deps bundled).
# Visual design completely independent of the inner CLI.
# Old nakedlunch-real kept as backup.
# User will test, then decide on renaming/commit/release.

CONFIG="/Users/yala/.config/ghostty/nakedlunch"
REAL="/Users/yala/nakedlunch/dist/nakedlunch"  # new built binary

# Force new Ghostty window with our config and run the real binary inside
open -n -a /Applications/Ghostty.app --args \
  --config-file="$CONFIG" \
  --command="$REAL"

# Force native macOS fullscreen (hides menu bar + dock, Ctrl+Cmd+F behavior)
sleep 1
osascript -e '
tell application "Ghostty" to activate
tell application "System Events"
    keystroke "f" using {control down, command down}
end tell
' >/dev/null 2>&1 &
