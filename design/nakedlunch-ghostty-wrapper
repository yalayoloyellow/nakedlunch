#!/bin/zsh
# Wrapper to launch nakedlunch in beautiful Ghostty CRT visual
# Design saved in /Users/yala/nakedlunch/design/ (config, shaders, this script, restore instructions)
# Using latest new nakedlunch (dist/nakedlunch from current source v1.1)
# Visual design (shaders + 4:3 padding + fullscreen) is 100% independent of the inner CLI.
#
# Для теста "постарше": поменяй REAL на /Users/yala/.local/bin/nakedlunch-v1.0-test
# (копия новой, переименованная для ручной проверки)

CONFIG="/Users/yala/.config/ghostty/nakedlunch"
# Using official latest release binary from GitHub (v1.1)
# Downloaded: nakedlunch-official-macos
# Old version kept as nakedlunch-real (previous)
# The Ghostty design (shaders, 4:3 padding, fullscreen, effects) is completely independent.
REAL="/Users/yala/nakedlunch/dist/nakedlunch-official-macos"  # official latest from GitHub release

# Force new Ghostty window with our config and run the real binary inside
open -n -a /Applications/Ghostty.app --args \
  --config-file="$CONFIG" \
  --command="$REAL"

# Force native macOS fullscreen (hides menu bar + dock, Ctrl+Cmd+F behavior)
sleep 1
osascript -e '
tell application "Ghostty" to activate
tell application "System Events"
    keystroke "f" using {control down, command down}
end tell
' >/dev/null 2>&1 &
