# nakedlunch — что НЕ едет в репозиторий и почему.
#
# Правило одно: в git живут ИСХОДНИКИ. Всё, что можно пересобрать из них, и всё,
# что принадлежит пользователю лично, остаётся на диске. Иначе клон весит два
# гигабайта, а история git не забывает ничего и никогда.
#
# ВНИМАНИЕ, ГРАБЛИ: комментарий В КОНЦЕ СТРОКИ git считает частью шаблона.
# Строка `/data/   # личное` не игнорирует ничего — она ищет каталог с пробелами
# и решёткой в имени. Ровно так первая версия этого файла и пропустила в индекс
# личный корпус и 1.6 ГБ таблиц (поймано перед первым коммитом). Комментарии
# здесь только на отдельных строках.

# --- окружение и мусор -------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Локальные разрешения и пути этой машины.
.claude/

# --- фронтенд ----------------------------------------------------------------
# СОБРАННЫЙ ФРОНТ ТЕПЕРЬ В РЕПОЗИТОРИИ (2026-09-09), и это осознанный размен.
#
# Здесь стояло `interface/react-app/dist/` с доводом «класть сюда сборку значит
# коммитить её при каждой правке одной строчки в src/». Довод верный, но цена
# у него оказалась выше: без сборки в репозитории на КАЖДОЙ установке нужен
# Node — то есть человек, который поставил программу, обязан поставить ещё и
# среду сборки. Три мегабайта против этого дёшевы.
#
# launch.py пересоберёт фронт сам, если npm есть и исходники новее; нет npm —
# работает на собранном и говорит об этом вслух.
interface/react-app/node_modules/

# Разовая безбраузерная проверка движка фристайла: собранный бандл плюс
# двенадцать строк шима. Артефакт прогона, а не исходник.
.smoketmp/

# --- ЖУРНАЛ ПРОЕКТА ----------------------------------------------------------
# Инженерный дневник проекта: он писался как внутренняя память и построен на
# дословных репликах. Решения и замеры из него перенесены в ARCHITECTURE.md —
# без цитат и без имён. Сам дневник остаётся на диске.
project-notes/

# --- следы сборки приложения -------------------------------------------------
# PyInstaller кладёт сюда промежуточные файлы и готовое приложение: сотни
# мегабайт, которые пересобираются одной командой.
/build/
/dist/
*.pyinstaller

# --- ЛИЧНОЕ ------------------------------------------------------------------
# Корпус принятых строк, история показов, избранное, положения крутилок, полки
# профилей, логи, статистика прогонов. Это работа пользователя, а не код.
#
# ЗВЁЗДОЧКА, А НЕ ПРОСТО КАТАЛОГ: git не заходит внутрь исключённого каталога,
# поэтому отрицание файла внутри `/data/` не работает вовсе. `/data/*`
# исключает содержимое, но сам каталог оставляет проходимым — только так
# исключение ниже имеет силу. Проверено `git check-ignore`.
/data/*

# Чёрный список — его слова, а не правила программы.
core/data/blacklist.json

# --- АРТЕФАКТЫ СБОРКИ (≈1.6 ГБ) ----------------------------------------------
# Пересобираются из tools/ — порядок и время в README. Мелкая входная таблица
# stanza_forms.json КОММИТИТСЯ: она входные данные, а не результат.
# (forms.json и lexicon.json снесены 2026-09-02 — надгробие в nakedlunch.spec.)
core/data/nl_rhyme.json
core/data/nl_rhyme.jsonl
core/data/nl_index/
# АДРЕСА СТРОК (2026-09-01) — тот же класс, что индекс: строится из книг и
# индекса за восемь минут, весит 77 МБ и в истории кода делать ему нечего.
core/data/nl_addr/

# Сайдкары прогресса сборок.
core/data/*.status.json

# --- хвосты атомарной записи -------------------------------------------------
# tmp + подмена: если процесс упал посреди записи, рядом остаётся такой файл.
*.новый
*.копия
*.восстановлено
*.tmp

# книги для проверки разбора форматов (2026-08-21) — не в репозиторий
/тест-книги/
